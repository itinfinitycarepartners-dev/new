{
  "name": "ItineraryItem",
  "type": "object",
  "properties": {
    "candidate_email": {
      "type": "string",
      "title": "Candidate Email"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Travel",
        "Housing",
        "Orientation",
        "Documentation",
        "Medical",
        "Social",
        "Other"
      ],
      "default": "Other"
    },
    "is_completed": {
      "type": "boolean",
      "title": "Completed",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "candidate_email",
    "title",
    "date"
  ]
}